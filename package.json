{
  "name": "semantic-spatial-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A dependency-free semantic spatial browser and WebMCP control plane for 3DGS scenes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whyme-Labs/semantic-spatial-webmcp.git"
  },
  "bugs": {
    "url": "https://github.com/Whyme-Labs/semantic-spatial-webmcp/issues"
  },
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "serve:dist": "python3 -m http.server 4173 --directory dist",
    "build": "node scripts/build.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "eval": "node scripts/run-evals.mjs",
    "test": "node --test",
    "check": "node scripts/verify.mjs --syntax-only",
    "verify": "node scripts/verify.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "check:submission:strict": "node scripts/check-submission.mjs --strict",
    "verify:webmcp:chrome": "node scripts/verify-webmcp-chrome.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.126.0"
  }
}
