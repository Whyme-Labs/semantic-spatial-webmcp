{
  "name": "semantic-spatial-webmcp-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A dependency-free semantic spatial browser and WebMCP control plane for 3DGS scenes.",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "serve:dist": "python3 -m http.server 4173 --directory dist",
    "build": "node scripts/build.mjs",
    "eval": "node scripts/run-evals.mjs",
    "test": "node --test",
    "check": "node scripts/verify.mjs --syntax-only",
    "verify": "node scripts/verify.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "check:submission:strict": "node scripts/check-submission.mjs --strict",
    "verify:webmcp:chrome": "node scripts/verify-webmcp-chrome.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
