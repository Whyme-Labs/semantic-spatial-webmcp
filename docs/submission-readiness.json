{
  "schemaVersion": 1,
  "gates": [
    {
      "id": "functioning-web-app",
      "category": "product",
      "requirement": "The repository contains a functioning WebMCP-powered web app and deterministic product tests.",
      "evidenceClass": "repository",
      "assertions": [
        { "type": "fileExists", "path": "index.html" },
        { "type": "fileExists", "path": "src/app.js" },
        { "type": "fileExists", "path": "test/tools.test.js" }
      ]
    },
    {
      "id": "webmcp-imperative-registration",
      "category": "webmcp",
      "requirement": "The app uses document.modelContext.registerTool and awaits registration failures.",
      "evidenceClass": "repository",
      "assertions": [
        { "type": "fileContains", "path": "src/webmcp-adapter.js", "contains": "document?.modelContext" },
        { "type": "fileContains", "path": "src/webmcp-adapter.js", "contains": "modelContext.registerTool" },
        { "type": "fileContains", "path": "src/webmcp-adapter.js", "contains": "await Promise.allSettled(registrations)" }
      ]
    },
    {
      "id": "webmcp-security-contract",
      "category": "security",
      "requirement": "Tool schemas are narrow and annotations use only standardized WebMCP fields.",
      "evidenceClass": "repository",
      "assertions": [
        { "type": "fileContains", "path": "src/tool-runtime.js", "contains": "additionalProperties: false" },
        { "type": "fileContains", "path": "src/tool-runtime.js", "contains": "readOnlyHint" },
        { "type": "fileNotContains", "path": "src/tool-runtime.js", "contains": "destructiveHint" },
        { "type": "fileNotContains", "path": "src/tool-runtime.js", "contains": "idempotentHint" }
      ]
    },
    {
      "id": "shared-scene-workflow",
      "category": "experience",
      "requirement": "Humans and tools share the live scene for routing, outages, alternate routes, evidence gaps, recapture, and undo.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "fileContains", "path": "docs/browser-verification.md", "contains": "Complete interaction path" },
        { "type": "fileContains", "path": "test/tools.test.js", "contains": "state tool changes route outcome" },
        { "type": "fileContains", "path": "src/tool-runtime.js", "contains": "undo_scene_change" },
        { "type": "fileContains", "path": "src/tool-runtime.js", "contains": "recommendations: quality.recommendations" }
      ]
    },
    {
      "id": "deterministic-verification",
      "category": "quality",
      "requirement": "The latest deterministic syntax and test receipt passes with zero failures.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "jsonValue", "path": "docs/build-verification.json", "pointer": "/nodeSyntaxCheck", "equals": "passed" },
        { "type": "jsonNumberAtLeast", "path": "docs/build-verification.json", "pointer": "/tests", "minimum": 24 },
        { "type": "jsonValue", "path": "docs/build-verification.json", "pointer": "/failures", "equals": 0 },
        { "type": "jsonValue", "path": "docs/build-verification.json", "pointer": "/result", "equals": "passed" }
      ]
    },
    {
      "id": "tool-reliability-coverage",
      "category": "quality",
      "requirement": "Tests cover registration failures, schema validation, visible side effects, output budgets, and explicit failure recovery.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "fileContains", "path": "test/tools.test.js", "contains": "human and agent navigation share results and viewer effects" },
        { "type": "fileContains", "path": "test/tool-validation.test.js", "contains": "runtime schemas reject extra fields" },
        { "type": "fileContains", "path": "test/tool-validation.test.js", "contains": "every successful tool result is plain JSON within the output budget" },
        { "type": "fileContains", "path": "test/webmcp-adapter.test.js", "contains": "one registration rejection aborts and settles the whole catalog" }
      ]
    },
    {
      "id": "guided-judge-path",
      "category": "experience",
      "requirement": "A one-click guided path demonstrates the complete reversible workflow and leaves no stale route or evidence overlay.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "fileContains", "path": "index.html", "contains": "Run guided proof" },
        { "type": "fileContains", "path": "src/app.js", "contains": "async function runGuidedProof()" },
        { "type": "fileContains", "path": "test/tools.test.js", "contains": "state changes invalidate derived overlays and undo leaves a clean baseline" },
        { "type": "fileContains", "path": "docs/browser-verification.md", "contains": "## Guided judge path" }
      ]
    },
    {
      "id": "camera-context-integrity",
      "category": "spatial-context",
      "requirement": "Entity navigation uses the reported named evidence pose and current region follows camera position.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "fileContains", "path": "src/splat-station-viewer.js", "contains": "resolveEntityView(entity, this.semanticScene.evidenceViews)" },
        { "type": "fileContains", "path": "src/splat-station-viewer.js", "contains": "worldPositionToSemantic(this.camera.position.toArray())" },
        { "type": "fileContains", "path": "test/spatial-coordinates.test.js", "contains": "named evidence poses drive entity navigation before the fallback" },
        { "type": "fileContains", "path": "test/spatial-coordinates.test.js", "contains": "current region lookup follows a semantic camera position" },
        { "type": "fileContains", "path": "test/viewer-adapter.test.js", "contains": "browser adapter preserves an explicit null camera region" }
      ]
    },
    {
      "id": "deterministic-prompt-evaluation",
      "category": "quality",
      "requirement": "The checked-in prompt fixtures execute their expected tool plans with grounded assertions and explicitly avoid claiming model-selection evidence.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "fileExists", "path": "evals/webmcp-cases.json" },
        { "type": "jsonNumberAtLeast", "path": "docs/evaluation-results.json", "pointer": "/cases", "minimum": 5 },
        { "type": "jsonNumberAtLeast", "path": "docs/evaluation-results.json", "pointer": "/assertions", "minimum": 20 },
        { "type": "jsonValue", "path": "docs/evaluation-results.json", "pointer": "/failures", "equals": 0 },
        { "type": "jsonValue", "path": "docs/evaluation-results.json", "pointer": "/result", "equals": "passed" }
      ]
    },
    {
      "id": "screenshot-context-comparison",
      "category": "evidence",
      "requirement": "The evidence package explains what a screenshot lacks and ties spatial-context claims to deterministic receipts.",
      "evidenceClass": "repository",
      "assertions": [
        { "type": "fileExists", "path": "submission/screenshots/context-comparison.svg" },
        { "type": "fileExists", "path": "submission/screenshots/context-comparison.png" },
        { "type": "fileContains", "path": "docs/context-comparison.md", "contains": "The left panel is a conceptual limitation diagram, not a model benchmark." },
        { "type": "fileContains", "path": "docs/context-comparison.md", "contains": "56% accessible-wayfinding readiness" }
      ]
    },
    {
      "id": "local-chrome-webmcp-verification",
      "category": "judge-runtime",
      "requirement": "A supported Chrome build discovers and executes the complete local WebMCP workflow with visible source-labelled effects.",
      "evidenceClass": "runtime",
      "assertions": [
        { "type": "fileExists", "path": "scripts/verify-webmcp-chrome.mjs" },
        { "type": "fileExists", "path": "submission/screenshots/chrome-webmcp-flow.png" },
        { "type": "fileContains", "path": "docs/browser-verification.md", "contains": "## Real Chrome WebMCP check" },
        { "type": "fileContains", "path": "docs/browser-verification.md", "contains": "WebMCP active: 10 tools registered" },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/artifact/kind", "equals": "allowlisted-dist" },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/timing/underFiveSeconds", "equals": true },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/webmcp/toolCount", "equals": 10 },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/flow/navigation/selectedViewId", "equals": "view_accessible_gate_1" },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/flow/navigation/cameraPose/position", "equals": [-3.708, 1.67, 2.76] },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/flow/navigation/currentRegion", "equals": null },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/flow/regionQuality/bestEvidenceViewIds/0", "equals": "view_sign_west_oblique" },
        { "type": "jsonNumberAtLeast", "path": "docs/webmcp-chrome-verification.json", "pointer": "/flow/regionQuality/recaptureMarkerCount", "minimum": 6 },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/console/errors", "equals": [] },
        { "type": "jsonValue", "path": "docs/webmcp-chrome-verification.json", "pointer": "/result", "equals": "passed" }
      ]
    },
    {
      "id": "graceful-browser-fallback",
